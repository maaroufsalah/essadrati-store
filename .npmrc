# Default isolated linker: each app resolves its own peers. The Medusa
# backend keeps React 18 for its admin while the storefront runs React 19,
# as in Medusa's official monorepo starter (medusajs/dtc-starter).
# Packages the Medusa admin bundler loads at runtime are declared
# explicitly in apps/backend/package.json.
auto-install-peers=true
strict-peer-dependencies=false
engine-strict=true
