# Production compose variables, read by docker-compose.prod.yml.
# On the VPS: cp .env.prod.example .env.prod, then run
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# App secrets live in infra/env/backend.prod.env and storefront.prod.env.
COMPOSE_PROJECT_NAME=essadrati
GHCR_OWNER=maaroufsalah
IMAGE_PREFIX=essadrati
IMAGE_TAG=latest

# Host ports bound to 127.0.0.1 only; Nginx proxies to them.
# Use different ports for each client hosted on the same VPS.
BACKEND_PORT=3121
STOREFRONT_PORT=3120

# Host directory for uploaded media, served directly by Nginx at /static/.
# Must be owned by uid 1000 (container user) and readable by www-data.
UPLOADS_DIR=/opt/essadrati/uploads

# Docker subnets, unique per client on one VPS and inside 172.16.0.0/12
# (opened to PostgreSQL by the host). 172.30.0.0/16 is taken (transport-toulouse).
DOCKER_EDGE_SUBNET=172.31.10.0/24
DOCKER_INTERNAL_SUBNET=172.31.11.0/24

# Generate with: openssl rand -base64 36
REDIS_PASSWORD=
