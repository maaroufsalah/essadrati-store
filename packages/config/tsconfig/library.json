{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library: internal packages bundled with tsup (types, theme, api-client)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  }
}
