# Storefront local development. Copy to .env and fill in. Never commit .env.

# Public values, inlined into the client bundle at build time.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by: pnpm --filter @nocido/backend store:setup
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Canonical URL of this storefront (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side calls. In Docker: http://backend:9000. Defaults to the public URL.
# MEDUSA_INTERNAL_URL=http://localhost:9000

# Same value as REVALIDATE_SECRET in apps/backend/.env.
REVALIDATE_SECRET=

# How long StoreSettings stay cached without an explicit revalidation, in seconds.
# SETTINGS_REVALIDATE_SECONDS=3600
