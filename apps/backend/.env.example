# Backend (Medusa) local development. Copy to .env and fill in. Never commit .env.
# Production values live in infra/env/backend.prod.env (see backend.prod.env.example).

# Dev database on the VPS, reached through an SSH tunnel kept open in another terminal:
#   ssh -N -L 5433:127.0.0.1:5432 nocido
DATABASE_URL=postgres://essadrati_dev:CHANGE_ME@localhost:5433/essadrati_dev
# Integration tests (@medusajs/test-utils) run against this database.
DB_TEST_URL=postgres://essadrati_dev:CHANGE_ME@localhost:5433/essadrati_test

# Public URL of this backend (no trailing slash). Used by the admin dashboard
# and as the base of uploaded file URLs.
MEDUSA_BACKEND_URL=http://localhost:9000

# Comma-separated origins.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:3000

# Generate each with: openssl rand -base64 48 (required in production).
JWT_SECRET=
COOKIE_SECRET=
# Encrypts secrets stored in StoreSettings, e.g. the SMTP password (step 4).
SETTINGS_ENCRYPTION_KEY=

# Uploaded files (File Module, local provider). Defaults: ./static served at
# MEDUSA_BACKEND_URL/static. In production Nginx serves FILE_UPLOAD_DIR.
# FILE_UPLOAD_DIR=static
# FILE_BASE_URL=http://localhost:9000/static

# Storefront on-demand revalidation (same value in the storefront .env).
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=

# Required in production only. In development, cache, event bus, workflow
# engine and locking run in memory.
# REDIS_URL=redis://localhost:6379

# Initial store setup (pnpm --filter @nocido/backend store:setup).
# ISO 3166-1 alpha-2 country and ISO 4217 currency, lower case.
SETUP_COUNTRY=ma
SETUP_CURRENCY=mad
