{
  "extends": "@nocido/config/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx",
    "sourceMap": false,
    "inlineSourceMap": true,
    "checkJs": false,
    "types": ["node"]
  },
  "ts-node": { "swc": true },
  "include": ["**/*", ".medusa/types/*"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin", ".cache"]
}
