{
  "name": "@nocido/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Medusa v2 backend: store API, admin API and admin dashboard.",
  "license": "UNLICENSED",
  "files": [
    ".medusa/server",
    "data"
  ],
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "predeploy": "medusa db:migrate",
    "db:migrate": "medusa db:migrate",
    "store:setup": "medusa exec ./src/scripts/setup-store.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('.medusa',{recursive:true,force:true})\"",
    "db:generate": "medusa db:generate storeSettings moroccanCities pages heroSlides categoryBanners redirects",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "cities:seed": "medusa exec ./src/scripts/seed-cities.ts",
    "catalog:seed": "medusa exec ./src/scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/dashboard": "2.21.1",
    "@medusajs/draft-order": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "@nocido/admin": "workspace:*",
    "@nocido/api-client": "workspace:*",
    "@nocido/theme": "workspace:*",
    "@nocido/types": "workspace:*",
    "@tanstack/react-query": "5.64.2",
    "ioredis": "5.8.2",
    "nodemailer": "10.0.13",
    "puppeteer-core": "25.12.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.1",
    "@nocido/config": "workspace:*",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
