# Backend (Medusa) production secrets.
# On the VPS: cp backend.prod.env.example backend.prod.env and fill in.
# Complete list of variables is maintained in apps/backend/.env.example.

# Host PostgreSQL (dedicated role and database, see infra/README.md).
# REDIS_URL is set by docker-compose.prod.yml.
DATABASE_URL=postgres://essadrati:CHANGE_ME@host.docker.internal:5432/essadrati

# Generate each with: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECRET=
# Key used to encrypt secrets stored in StoreSettings (SMTP password).
SETTINGS_ENCRYPTION_KEY=

# Public URLs (no trailing slash). Staging values; final domain comes later.
MEDUSA_BACKEND_URL=https://api-essadrati.nocido.com
STORE_CORS=https://essadrati.nocido.com
ADMIN_CORS=https://admin-essadrati.nocido.com
AUTH_CORS=https://admin-essadrati.nocido.com,https://essadrati.nocido.com

# Uploaded files: written to the container volume, served by Nginx.
FILE_UPLOAD_DIR=/app/uploads
FILE_BASE_URL=https://api-essadrati.nocido.com/uploads

# Storefront cache revalidation (same value in storefront.prod.env).
STOREFRONT_URL=http://storefront:3000
REVALIDATE_SECRET=

# Run database migrations when the container starts.
RUN_MIGRATIONS=true
