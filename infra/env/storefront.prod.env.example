# Storefront (Next.js) runtime values.
# NEXT_PUBLIC_* values are baked in at image build time (GitHub Actions
# build args), not read from this file. Staging values:
#   NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api-essadrati.nocido.com
#   NEXT_PUBLIC_SITE_URL=https://essadrati.nocido.com
# MEDUSA_INTERNAL_URL is set by docker-compose.prod.yml.
# Complete list of variables is maintained in apps/storefront/.env.example.

# Same value as backend.prod.env.
REVALIDATE_SECRET=

# Cache lifetime of StoreSettings without an explicit revalidation, in seconds.
SETTINGS_REVALIDATE_SECONDS=3600
